{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Robot: charge mode (PWM off)",
      "type": "process",
      "command": "${workspaceFolder}/robot",
      "args": ["charge"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Robot: arm for untethered use",
      "type": "process",
      "command": "${workspaceFolder}/robot",
      "args": ["arm"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Robot: stop PWM",
      "type": "process",
      "command": "${workspaceFolder}/robot",
      "args": ["stop"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Robot: read state without stopping",
      "type": "process",
      "command": "${workspaceFolder}/robot",
      "args": ["status"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Robot: set up tools",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "setup"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Robot: build centering firmware",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "build"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Robot: find XIAO",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "ports"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Robot: upload disarmed centering firmware",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "upload"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Robot: check USB with PWM stopped",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "check"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Robot: serial monitor",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "monitor"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Robot: test shutdown logic",
      "type": "process",
      "command": "python3",
      "args": ["scripts/robot.py", "test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
